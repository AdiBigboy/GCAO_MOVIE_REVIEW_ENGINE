# Machine-Specific Environment Configuration Template
# Copy this file to .env and configure your local paths and keys.

# Gemini API Key (Required for live multimodal AI analysis)
GEMINI_API_KEY=

# Optional Gemini Model override (Default: gemini-flash-latest)
# GEMINI_MODEL=gemini-flash-latest

# External Movie Source Path (Machine-specific)
# Main PC example: MOVIES_SOURCE=F:\MOVIES_SOURCE
# Laptop example: MOVIES_SOURCE=C:\Users\User\Documents\GCAO_MOVIE_REVIEW_ENGINE\cache
MOVIES_SOURCE=
